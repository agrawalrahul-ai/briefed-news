    {
      "parameters": {
        "jsCode": "const items = [];\nconst llmItems = $input.all();\nconst articleItems = $('Code (unpack articles)').all();\nfor (let i = 0; i < llmItems.length; i++) {\n  const summary = llmItems[i].json.output[0].content[0].text.trim();\n  const article = articleItems[i].json;\n  items.push({\n    json: {\n      title: article.title,\n      url: article.url,\n      source: article.source,\n      image: article.image,\n      publishedAt: article.publishedAt,\n      category: article.category,\n      summary: summary,\n      wordCount: Number(summary.split(' ').length)\n    }\n  });\n}\nreturn items;"
      },
