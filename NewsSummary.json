    {
      "parameters": {
        "jsCode": "const articles = $input.first().json.articles;\nconst grouped = {};\n\nfor (const a of articles) {\n  const cat = a.category || 'general';\n  if (!grouped[cat]) grouped[cat] = [];\n  grouped[cat].push(a);\n}\n\nreturn [{\n  json: {\n    updatedAt: new Date().toISOString(),\n    categories: grouped\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
